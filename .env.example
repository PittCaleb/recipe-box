# Copy this file to .env and fill in real values. .env is gitignored --
# never commit it. Every variable here is optional except ANTHROPIC_API_KEY,
# which is required only if you use Admin -> Import a new PDF or want drawn
# placeholder pictures for recipes without a photo.
# See README.md -> "Getting an Anthropic API key" for how to generate one.

ANTHROPIC_API_KEY=

# --- Everything below has a sensible default; uncomment only to override. ---

# RECIPES_DATA_DIR=./data
# RECIPES_HOST=0.0.0.0
# RECIPES_PORT=5050
# RECIPES_HOME_HOSTS=localhost,127.0.0.1
# RECIPES_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# RECIPES_ACCESS_AUD=
# RECIPES_COOKBOOK_TITLE=Our Family Recipes
# RECIPES_IMPORT_MODEL=claude-opus-5-5
# RECIPES_PLACEHOLDER_MODEL=claude-sonnet-5-5
# RECIPES_PDF_DIR=./pdf
